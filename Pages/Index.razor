@page "/"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using System.Text.RegularExpressions;
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient

<PageTitle>Cloud Icons - Search All Icons</PageTitle>

<div class="unified-container">
    <div class="search-header">
        <h1>☁️ Cloud Icons</h1>
        <p class="subtitle">Search across 8,000+ official cloud icons from Azure, AWS, GCP, and more</p>
    </div>

    <div class="search-container">
        <div class="search-input-group">
            <input type="text" 
                   @bind="searchTerm" 
                   @bind:event="oninput" 
                   @onkeyup="SearchDebounced" 
                   placeholder="🔍 Search all icons (e.g., 'database', 'storage', 'kubernetes')..." 
                   class="search-input" />
        </div>
        
        <div class="search-filters">
            <div class="filter-group">
                <label class="filter-label">
                    <input type="checkbox" id="downloadAsPng" @bind="DownloadAsPng" />
                    <span>📥 Download as PNG</span>
                </label>
            </div>

            <div class="provider-filters">
                <span class="filter-title">Providers:</span>
                @foreach (var provider in providers)
                {
                    <label class="filter-badge">
                        <input type="checkbox" 
                               checked="@selectedProviders[provider.Key]"
                               @onchange="async (e) => await OnProviderFilterChanged(provider.Key, e.Value is bool b && b)" />
                        <span>@provider.Value</span>
                    </label>
                }
            </div>

            @if (totalIconsLoaded > 0)
            {
                <div class="results-info">
                    📊 Found <strong>@filteredIcons.Count</strong> / <strong>@totalIconsLoaded</strong> icons
                </div>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading-section">
            <div class="loading-spinner">
                <p>Loading icons...</p>
                <p class="loading-detail">@loadingMessage</p>
            </div>
        </div>
    }
    else if (allIcons.Count == 0)
    {
        <div class="no-results">
            <div class="no-results-icon">📭</div>
            <div class="no-results-text">No icons loaded</div>
        </div>
    }
    else if (filteredIcons.Count == 0)
    {
        <div class="no-results">
            <div class="no-results-icon">🔍</div>
            <div class="no-results-text">No icons found matching "<strong>@searchTerm</strong>"</div>
            <p class="no-results-hint">Try searching by category or provider name</p>
        </div>
    }
    else
    {
        <div class="results-summary">
            <p>Showing @filteredIcons.Count icons</p>
        </div>

        <div class="svg-grid">
            @foreach (var icon in filteredIcons)
            {
                var safeId = GenerateSafeId(icon.Name);
                <div class="svg-item-wrapper">
                    <div class="svg-item">
                        <div class="provider-badge">@icon.Provider</div>
                        <img id="@safeId" 
                             src="@icon.Path" 
                             alt="@icon.Name" 
                             title="@GetIconTitle(icon)"
                             @oncontextmenu="@(e => OnRightClick(e, safeId, icon.Name))"
                             @oncontextmenu:preventDefault="true" />
                        @if (DownloadAsPng)
                        {
                            <a @onclick="() => OnDownloadRequested(safeId, icon.Name)" class="action-btn">📥 PNG</a>
                        }
                        else
                        {
                            <a href="@icon.Path" download="@icon.Name" class="action-btn">📄 SVG</a>
                        }
                    </div>
                    <p class="icon-name" title="@icon.Name">@(icon.Name.Length > 32 ? icon.Name.Substring(0, 32) + "..." : icon.Name)</p>
                    <p class="icon-category">@(string.IsNullOrEmpty(icon.Category) ? "—" : icon.Category)</p>
                </div>
            }
        </div>

        @if (hasMoreToLoad)
        {
            <div class="load-more-container">
                <button class="load-more-btn" @onclick="LoadMore">Load More Icons ⬇️</button>
            </div>
        }
    }
</div>

@implements IDisposable

@code {
    private string searchTerm = string.Empty;
    private List<IconData> allIcons = new List<IconData>();
    private List<IconData> filteredIcons = new List<IconData>();
    private int currentPage = 1;
    private int pageSize = 30;
    private int totalIconsLoaded = 0;
    private bool hasMoreToLoad = true;
    private bool DownloadAsPng { get; set; }
    private bool isLoading = true;
    private string loadingMessage = "Initializing...";
    private System.Timers.Timer? debounceTimer;

    private Dictionary<string, string> providers = new()
    {
        { "azure", "🎨 Azure" },
        { "aws", "☁️ AWS" },
        { "gcp", "🌐 Google Cloud" },
        { "fabric", "📊 Fabric" },
        { "microsoft365", "📋 Microsoft 365" },
        { "powerplatform", "⚡ Power Platform" },
        { "dynamics365", "💼 Dynamics 365" },
        { "entra", "🔐 Entra" }
    };

    private Dictionary<string, bool> selectedProviders = new();

    protected override async Task OnInitializedAsync()
    {
        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (sender, e) => await SearchDebounceElapsed();
        debounceTimer.AutoReset = false;

        foreach (var provider in providers.Keys)
        {
            selectedProviders[provider] = true;
        }

        await LoadAllIconsMetadata();
    }

    private async Task LoadAllIconsMetadata()
    {
        try
        {
            isLoading = true;
            allIcons.Clear();
            filteredIcons.Clear();
            currentPage = 1;
            StateHasChanged();

            int loadedCount = 0;
            foreach (var (providerKey, providerName) in providers)
            {
                loadingMessage = $"Loading {providerName}...";
                StateHasChanged();

                try
                {
                    var response = await HttpClient.GetFromJsonAsync<IconsMetadata>($"data/{providerKey}.json");
                    if (response?.Icons != null)
                    {
                        foreach (var icon in response.Icons)
                        {
                            allIcons.Add(new IconData
                            {
                                Name = icon.Name,
                                Path = icon.Path,
                                FileName = icon.FileName,
                                Provider = providerKey,
                                ProviderName = providerName,
                                Category = ExtractCategory(icon.Path)
                            });
                        }
                        loadedCount += response.Icons.Count;
                        totalIconsLoaded = loadedCount;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading {providerKey}: {ex.Message}");
                }
            }

            await LoadSvgs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading icons: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSvgs()
    {
        var svgFiles = await SearchSvgsAsync(searchTerm, currentPage, pageSize);
        hasMoreToLoad = svgFiles.Count == pageSize;

        if (currentPage == 1)
        {
            filteredIcons = svgFiles;
        }
        else
        {
            filteredIcons.AddRange(svgFiles);
        }

        StateHasChanged();
    }

    private async Task<List<IconData>> SearchSvgsAsync(string searchTerm, int page, int pageSize)
    {
        await Task.CompletedTask;

        var query = allIcons.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var lowerSearchTerm = searchTerm.ToLower();
            query = query.Where(icon =>
                icon.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                icon.Category.Contains(lowerSearchTerm) ||
                icon.ProviderName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            );
        }

        query = query.Where(icon => selectedProviders[icon.Provider]);

        var paginatedIcons = query
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        return paginatedIcons;
    }

    private string ExtractCategory(string path)
    {
        try
        {
            var parts = path.Split('/');
            if (parts.Length > 2)
            {
                return string.Join(" ", parts.Skip(2).Take(Math.Max(0, parts.Length - 3)))
                    .ToLower()
                    .Replace("-", " ")
                    .Replace("+", " ")
                    .Trim();
            }
        }
        catch { }
        return string.Empty;
    }

    private void SearchDebounced()
    {
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async Task SearchDebounceElapsed()
    {
        await InvokeAsync(async () =>
        {
            currentPage = 1;
            await LoadSvgs();
            StateHasChanged();
        });
    }

    private async Task OnProviderFilterChanged(string provider, bool isSelected)
    {
        selectedProviders[provider] = isSelected;
        currentPage = 1;
        await LoadSvgs();
    }

    private async Task LoadMore()
    {
        currentPage++;
        await LoadSvgs();
    }

    private string GenerateSafeId(string name)
    {
        return "svg_" + Regex.Replace(name, @"[^a-zA-Z0-9]+", "_");
    }

    private string GetIconTitle(IconData icon)
    {
        return string.IsNullOrEmpty(icon.Category) ? icon.Name : $"{icon.Name} - {icon.Category}";
    }

    private async Task OnDownloadRequested(string safeId, string fileName)
    {
        if (DownloadAsPng)
        {
            await JSRuntime.InvokeVoidAsync("downloadAsPng", safeId, fileName);
        }
    }

    private async Task OnRightClick(MouseEventArgs e, string safeId, string fileName)
    {
        await JSRuntime.InvokeVoidAsync("copyImageToClipboard", safeId, fileName);
    }

    private class IconData
    {
        public string Name { get; set; } = string.Empty;
        public string Path { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
    }

    private class SvgFile
    {
        [JsonPropertyName("path")]
        public string Path { get; set; } = string.Empty;

        [JsonPropertyName("name")]
        public string Name { get; set; } = string.Empty;

        [JsonPropertyName("fileName")]
        public string FileName { get; set; } = string.Empty;
    }

    private class IconsMetadata
    {
        public string Category { get; set; } = string.Empty;
        public int Count { get; set; }
        public List<SvgFile> Icons { get; set; } = new List<SvgFile>();
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}
