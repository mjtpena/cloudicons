@page "/"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using System.Text.RegularExpressions;
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient

<PageTitle>Cloud Icons - Search 8000+ Official Cloud Icons</PageTitle>

<div class="unified-container">
    <!-- Enhanced Header with Better Visual Hierarchy -->
    <div class="search-header">
        <div class="header-content">
            <h1 class="header-title">☁️ Cloud Icons</h1>
            <p class="header-subtitle">Instantly search and download 8,000+ official cloud service icons</p>
        </div>
    </div>

    <!-- Improved Search Bar with Better Layout -->
    <div class="search-section">
        <div class="search-box-wrapper">
            <div class="search-input-wrapper">
                <span class="search-icon">🔍</span>
                <input type="text" 
                       @bind="searchTerm" 
                       @bind:event="oninput" 
                       @onkeyup="SearchDebounced" 
                       placeholder="Search by name, category or provider..." 
                       class="search-input-enhanced" />
                @if (!string.IsNullOrEmpty(searchTerm))
                {
                    <button @onclick="ClearSearch" class="clear-btn" title="Clear search">✕</button>
                }
            </div>
        </div>

        <!-- Better Filter Organization -->
        <div class="filters-section">
            <div class="filters-row">
                <!-- Download Format Toggle -->
                <div class="filter-group-vertical">
                    <label class="filter-group-title">Format:</label>
                    <div class="format-toggle">
                        <label class="toggle-option @(DownloadAsPng ? "active" : "")">
                            <input type="radio" value="svg" @onchange="@((ChangeEventArgs e) => DownloadAsPng = false)" />
                            <span>📄 SVG</span>
                        </label>
                        <label class="toggle-option @(DownloadAsPng ? "active" : "")">
                            <input type="radio" value="png" @onchange="@((ChangeEventArgs e) => DownloadAsPng = true)" />
                            <span>📥 PNG</span>
                        </label>
                    </div>
                </div>

                <!-- Provider Chips -->
                <div class="filter-group-vertical">
                    <label class="filter-group-title">Providers:</label>
                    <div class="provider-chips">
                        @foreach (var provider in providers)
                        {
                            <label class="provider-chip @(selectedProviders[provider.Key] ? "active" : "")">
                                <input type="checkbox" 
                                       checked="@selectedProviders[provider.Key]"
                                       @onchange="async (e) => await OnProviderFilterChanged(provider.Key, e.Value is bool b && b)" />
                                <span>@provider.Value</span>
                            </label>
                        }
                    </div>
                </div>

                <!-- Results Counter -->
                @if (totalIconsLoaded > 0)
                {
                    <div class="results-counter">
                        <div class="counter-value">@filteredIcons.Count</div>
                        <div class="counter-label">of @totalIconsLoaded icons</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-content">
                <div class="loader-spinner"></div>
                <p class="loading-text">@loadingMessage</p>
            </div>
        </div>
    }
    <!-- Empty State -->
    else if (allIcons.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">📭</div>
            <h3>No icons loaded</h3>
            <p>Something went wrong. Please refresh the page.</p>
        </div>
    }
    <!-- No Results State -->
    else if (filteredIcons.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon">🔍</div>
            <h3>No icons found</h3>
            <p>Try searching with different keywords or adjust your provider filters</p>
            <button @onclick="ResetSearch" class="reset-btn">Reset Search</button>
        </div>
    }
    <!-- Results Grid -->
    else
    {
        <div class="results-section">
            <div class="grid-header">
                <span class="grid-info">Showing @filteredIcons.Count icon@(filteredIcons.Count != 1 ? "s" : "")</span>
            </div>

            <div class="icons-grid">
                @foreach (var icon in filteredIcons)
                {
                    var safeId = GenerateSafeId(icon.Name);
                    <div class="icon-card">
                        <div class="icon-image-container">
                            <img id="@safeId" 
                                 src="@icon.Path" 
                                 alt="@icon.Name" 
                                 title="@GetIconTitle(icon)"
                                 @oncontextmenu="@(e => OnRightClick(e, safeId, icon.Name))"
                                 @oncontextmenu:preventDefault="true"
                                 class="icon-image" />
                            <div class="icon-overlay">
                                <button @onclick="() => OnDownloadRequested(safeId, icon.Name)" 
                                        class="overlay-btn download-btn" 
                                        title="Download icon">
                                    @(DownloadAsPng ? "📥 PNG" : "📄 SVG")
                                </button>
                                <button @onclick="() => OnRightClick(null, safeId, icon.Name)" 
                                        class="overlay-btn copy-btn" 
                                        title="Copy to clipboard">
                                    📋 Copy
                                </button>
                            </div>
                            <span class="provider-label">@icon.ProviderName</span>
                        </div>
                        <div class="icon-info">
                            <h4 class="icon-title" title="@icon.Name">@(icon.Name.Length > 40 ? icon.Name.Substring(0, 40) + "..." : icon.Name)</h4>
                            @if (!string.IsNullOrEmpty(icon.Category))
                            {
                                <p class="icon-category">@icon.Category</p>
                            }
                        </div>
                    </div>
                }
            </div>

            <!-- Load More Button -->
            @if (hasMoreToLoad)
            {
                <div class="load-more-section">
                    <button @onclick="LoadMore" class="load-more-btn">
                        Load More Icons ⬇️
                    </button>
                </div>
            }
        </div>
    }
</div>

@implements IDisposable

@code {
    private string searchTerm = string.Empty;
    private List<IconData> allIcons = new List<IconData>();
    private List<IconData> filteredIcons = new List<IconData>();
    private int currentPage = 1;
    private int pageSize = 30;
    private int totalIconsLoaded = 0;
    private bool hasMoreToLoad = true;
    private bool DownloadAsPng { get; set; }
    private bool isLoading = true;
    private string loadingMessage = "Initializing...";
    private System.Timers.Timer? debounceTimer;

    private Dictionary<string, string> providers = new()
    {
        { "azure", "🎨 Azure" },
        { "aws", "☁️ AWS" },
        { "gcp", "🌐 Google Cloud" },
        { "fabric", "📊 Fabric" },
        { "microsoft365", "📋 Microsoft 365" },
        { "powerplatform", "⚡ Power Platform" },
        { "dynamics365", "💼 Dynamics 365" },
        { "entra", "🔐 Entra" }
    };

    private Dictionary<string, bool> selectedProviders = new();

    protected override async Task OnInitializedAsync()
    {
        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (sender, e) => await SearchDebounceElapsed();
        debounceTimer.AutoReset = false;

        foreach (var provider in providers.Keys)
        {
            selectedProviders[provider] = true;
        }

        await LoadAllIconsMetadata();
    }

    private async Task LoadAllIconsMetadata()
    {
        try
        {
            isLoading = true;
            allIcons.Clear();
            filteredIcons.Clear();
            currentPage = 1;
            StateHasChanged();

            int loadedCount = 0;
            foreach (var (providerKey, providerName) in providers)
            {
                loadingMessage = $"Loading {providerName.Split(' ')[1..]}...";
                StateHasChanged();

                try
                {
                    var response = await HttpClient.GetFromJsonAsync<IconsMetadata>($"data/{providerKey}.json");
                    if (response?.Icons != null)
                    {
                        foreach (var icon in response.Icons)
                        {
                            allIcons.Add(new IconData
                            {
                                Name = icon.Name,
                                Path = icon.Path,
                                FileName = icon.FileName,
                                Provider = providerKey,
                                ProviderName = providerName,
                                Category = ExtractCategory(icon.Path)
                            });
                        }
                        loadedCount += response.Icons.Count;
                        totalIconsLoaded = loadedCount;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error loading {providerKey}: {ex.Message}");
                }
            }

            await LoadSvgs();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading icons: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSvgs()
    {
        var svgFiles = await SearchSvgsAsync(searchTerm, currentPage, pageSize);
        hasMoreToLoad = svgFiles.Count == pageSize;

        if (currentPage == 1)
        {
            filteredIcons = svgFiles;
        }
        else
        {
            filteredIcons.AddRange(svgFiles);
        }

        StateHasChanged();
    }

    private async Task<List<IconData>> SearchSvgsAsync(string searchTerm, int page, int pageSize)
    {
        await Task.CompletedTask;

        var query = allIcons.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var lowerSearchTerm = searchTerm.ToLower();
            query = query.Where(icon =>
                icon.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                icon.Category.Contains(lowerSearchTerm) ||
                icon.ProviderName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)
            );
        }

        query = query.Where(icon => selectedProviders[icon.Provider]);

        var paginatedIcons = query
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        return paginatedIcons;
    }

    private string ExtractCategory(string path)
    {
        try
        {
            var parts = path.Split('/');
            if (parts.Length > 2)
            {
                return string.Join(" ", parts.Skip(2).Take(Math.Max(0, parts.Length - 3)))
                    .ToLower()
                    .Replace("-", " ")
                    .Replace("+", " ")
                    .Trim();
            }
        }
        catch { }
        return string.Empty;
    }

    private void SearchDebounced()
    {
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async Task SearchDebounceElapsed()
    {
        await InvokeAsync(async () =>
        {
            currentPage = 1;
            await LoadSvgs();
            StateHasChanged();
        });
    }

    private async Task OnProviderFilterChanged(string provider, bool isSelected)
    {
        selectedProviders[provider] = isSelected;
        currentPage = 1;
        await LoadSvgs();
    }

    private async Task LoadMore()
    {
        currentPage++;
        await LoadSvgs();
    }

    private void ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
    }

    private void ResetSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        foreach (var provider in providers.Keys)
        {
            selectedProviders[provider] = true;
        }
    }

    private string GenerateSafeId(string name)
    {
        return "svg_" + Regex.Replace(name, @"[^a-zA-Z0-9]+", "_");
    }

    private string GetIconTitle(IconData icon)
    {
        return string.IsNullOrEmpty(icon.Category) ? icon.Name : $"{icon.Name} - {icon.Category}";
    }

    private async Task OnDownloadRequested(string safeId, string fileName)
    {
        if (DownloadAsPng)
        {
            await JSRuntime.InvokeVoidAsync("downloadAsPng", safeId, fileName);
        }
    }

    private async Task OnRightClick(MouseEventArgs? e, string safeId, string fileName)
    {
        await JSRuntime.InvokeVoidAsync("copyImageToClipboard", safeId, fileName);
    }

    private class IconData
    {
        public string Name { get; set; } = string.Empty;
        public string Path { get; set; } = string.Empty;
        public string FileName { get; set; } = string.Empty;
        public string Provider { get; set; } = string.Empty;
        public string ProviderName { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
    }

    private class SvgFile
    {
        [JsonPropertyName("path")]
        public string Path { get; set; } = string.Empty;

        [JsonPropertyName("name")]
        public string Name { get; set; } = string.Empty;

        [JsonPropertyName("fileName")]
        public string FileName { get; set; } = string.Empty;
    }

    private class IconsMetadata
    {
        public string Category { get; set; } = string.Empty;
        public int Count { get; set; }
        public List<SvgFile> Icons { get; set; } = new List<SvgFile>();
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}
