@page "/iconlist/{Tab}"
@using System.Net.Http.Json
@using System.Globalization;
@using System.Text.Json.Serialization
@using System.Text.RegularExpressions;
@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient

<div class="search-container">
    <div class="search-input-group">
        <input type="text" @bind="searchTerm" @bind:event="oninput" @onkeyup="SearchDebounced" placeholder="🔍 Search icons by name (e.g., 'database', 'storage')..." />
    </div>
    
    <div class="search-filters">
        <input type="checkbox" id="downloadAsPng" @bind="DownloadAsPng" />
        <label for="downloadAsPng">📥 Download as PNG</label>
        
        @if (totalIcons > 0)
        {
            <span class="filter-badge">
                📊 Found @filteredSvgs.Count / @totalIcons icons
            </span>
        }
    </div>
</div>

@if (isLoading)
{
    <div class="text-center mt-4">
        <div class="loading-spinner">
            <p>Loading icons...</p>
        </div>
    </div>
}
else if (allSvgs.Count == 0)
{
    <div class="no-results">
        <div class="no-results-icon">📭</div>
        <div class="no-results-text">No icons available for this category</div>
    </div>
}
else if (filteredSvgs.Count == 0)
{
    <div class="no-results">
        <div class="no-results-icon">🔍</div>
        <div class="no-results-text">No icons found matching "<strong>@searchTerm</strong>"</div>
    </div>
}
else
{
    <div class="svg-grid">
        @foreach (var svg in filteredSvgs)
        {
            var safeId = GenerateSafeId(svg.Name);
            <div class="svg-item-wrapper">
                <div class="svg-item">
                    <img id="@safeId" src="@svg.Path" alt="@svg.Name" 
                         @oncontextmenu="@(e => OnRightClick(e, safeId, svg.Name))"
                         @oncontextmenu:preventDefault="true"
                         title="Right-click to copy • @svg.Name" />
                    @if (DownloadAsPng)
                    {
                        <a @onclick="() => OnDownloadRequested(safeId, svg.Name)">📥 PNG</a>
                    }
                    else
                    {
                        <a href="@svg.Path" download="@svg.Name">📄 SVG</a>
                    }
                </div>
                <p title="@svg.Name">@(svg.Name.Length > 32 ? svg.Name.Substring(0, 32) + "..." : svg.Name)</p>
            </div>
        }
    </div>

    @if (hasMoreToLoad)
    {
        <div class="load-more-container">
            <button class="load-more-btn" @onclick="LoadMore">Load More Icons ⬇️</button>
        </div>
    }
}

@implements IDisposable

@code {
    [Parameter] public string Tab { get; set; } = string.Empty;

    private string previousTab = string.Empty;

    private string searchTerm = string.Empty;
    private List<SvgFile> allSvgs = new List<SvgFile>();
    private List<SvgFile> filteredSvgs = new List<SvgFile>();
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalIcons = 0;
    private bool hasMoreToLoad = true;
    private bool DownloadAsPng { get; set; }
    private bool isLoading = true;
    private System.Timers.Timer? debounceTimer;

    protected override async Task OnInitializedAsync()
    {
        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.Elapsed += async (sender, e) => await SearchDebounceElapsed();
        debounceTimer.AutoReset = false;

        await LoadIconsMetadata();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Tab != previousTab)
        {
            previousTab = Tab;
            currentPage = 1;
            searchTerm = string.Empty;
            await LoadIconsMetadata();
        }
    }

    private async Task LoadIconsMetadata()
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            var response = await HttpClient.GetFromJsonAsync<IconsMetadata>($"data/{Tab}.json");
            if (response != null)
            {
                allSvgs = response.Icons ?? new List<SvgFile>();
                totalIcons = allSvgs.Count;
                await LoadSvgs();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading icons metadata: {ex.Message}");
            allSvgs = new List<SvgFile>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadSvgs()
    {
        var svgFiles = await SearchSvgsAsync(searchTerm, currentPage, pageSize);
        
        hasMoreToLoad = svgFiles.Count == pageSize;

        if (currentPage == 1)
        {
            filteredSvgs = svgFiles;
        }
        else
        {
            filteredSvgs.AddRange(svgFiles);
        }

        StateHasChanged();
    }

    private async Task<List<SvgFile>> SearchSvgsAsync(string searchTerm, int page, int pageSize)
    {
        await Task.CompletedTask;

        var query = allSvgs.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var lowerSearchTerm = searchTerm.ToLower();
            query = query.Where(icon => 
                icon.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                ExtractCategoryFromPath(icon.Path).Contains(lowerSearchTerm)
            );
        }

        var paginatedIcons = query
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        return paginatedIcons;
    }

    private string ExtractCategoryFromPath(string path)
    {
        try
        {
            var parts = path.Split('/');
            if (parts.Length > 2)
            {
                return string.Join(" ", parts.Skip(2).Take(parts.Length - 3))
                    .ToLower()
                    .Replace("-", " ")
                    .Replace("+", " ");
            }
        }
        catch { }
        return string.Empty;
    }

    private void SearchDebounced()
    {
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async Task SearchDebounceElapsed()
    {
        await InvokeAsync(async () =>
        {
            currentPage = 1;
            await LoadSvgs();
            StateHasChanged();
        });
    }

    private async Task LoadMore()
    {
        currentPage++;
        await LoadSvgs();
    }

    private string GenerateSafeId(string name)
    {
        return "svg_" + Regex.Replace(name, @"[^a-zA-Z0-9]+", "_");
    }

    private async Task OnDownloadRequested(string safeId, string fileName)
    {
        if (DownloadAsPng)
        {
            await JSRuntime.InvokeVoidAsync("downloadAsPng", safeId, fileName);
        }
    }

    private async Task OnRightClick(MouseEventArgs e, string safeId, string fileName)
    {
        await JSRuntime.InvokeVoidAsync("copyImageToClipboard", safeId, fileName);
    }

    private class SvgFile
    {
        [JsonPropertyName("path")]
        public string Path { get; set; } = string.Empty;
        
        [JsonPropertyName("name")]
        public string Name { get; set; } = string.Empty;
        
        [JsonPropertyName("fileName")]
        public string FileName { get; set; } = string.Empty;
    }

    private class IconsMetadata
    {
        public string Category { get; set; } = string.Empty;
        public int Count { get; set; }
        public List<SvgFile> Icons { get; set; } = new List<SvgFile>();
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }
}